---
/* MODIFIED: 2026-09-18 Post Pulse Design System Implementation */
import { cn } from "../../../../lib/cn";

type AlertVariant = "info" | "success" | "warning" | "destructive";

const variantClasses: Record<AlertVariant, string> = {
  info: "ui-alert--info",
  success: "ui-alert--success",
  warning: "ui-alert--warning",
  destructive: "ui-alert--destructive",
};

export interface Props {
  variant?: AlertVariant;
  dismissible?: boolean;
  class?: string;
}

const { variant, dismissible = false, class: className } = Astro.props as Props;
---

<div
  class={cn(
    "ui-alert",
    variant ? variantClasses[variant] : variantClasses.info,
    className,
  )}
  role="alert"
>
  <div class="ui-alert__content">
    <slot />
  </div>
  {
    dismissible && (
      <button type="button" class="ui-alert__close" aria-label="Dismiss alert">
        ×
      </button>
    )
  }
</div>

<style>
  .ui-alert {
    display: flex;
    align-items: flex-start;
    justify-content: space-between;
    gap: var(--spacing-4);
    padding: 16px 20px;
    border-radius: 0px;
    border: none;
    border-left: 2px solid;
  }
  .ui-alert__content {
    display: inline-flex;
    align-items: flex-start;
    gap: 0;
    width: 100%;
  }
  .ui-alert--info {
    border-color: var(--info);
    background: rgba(97, 124, 133, 0.08);
    color: var(--foreground);
  }
  .ui-alert--success {
    border-color: var(--success);
    background: rgba(45, 122, 74, 0.08);
    color: var(--foreground);
  }
  .ui-alert--warning {
    border-color: var(--warning);
    background: rgba(184, 134, 11, 0.08);
    color: var(--foreground);
  }
  .ui-alert--destructive {
    border-color: var(--destructive);
    background: rgba(147, 36, 37, 0.08);
    color: var(--foreground);
  }
  .ui-alert__close {
    background: transparent;
    border: none;
    color: var(--foreground);
    cursor: pointer;
    font-size: 1.5rem;
    padding: 0;
    margin-left: auto;
  }
</style>
