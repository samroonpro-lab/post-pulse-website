---
/* MODIFIED: 2026-09-18 Post Pulse Design System Implementation */
export interface Props {
  id: string;
  name: string;
  label: string;
  checked?: boolean;
}

const { id, name, label, checked = false } = Astro.props as Props;
---

<label class="ui-switch">
  <input id={id} name={name} type="checkbox" checked={checked} class="ui-switch__input" />
  <span class="ui-switch__track"><span class="ui-switch__thumb"></span></span>
  <span class="ui-switch__label">{label}</span>
</label>

<style>
  .ui-switch {
    display: inline-flex;
    align-items: center;
    gap: 0.75rem;
    cursor: pointer;
  }
  .ui-switch__input {
    position: absolute;
    opacity: 0;
  }
  .ui-switch__track {
    width: 44px;
    height: 24px;
    border-radius: 0px;
    background: var(--border);
    padding: 2px;
    display: inline-flex;
    align-items: center;
    border: 1px solid var(--border);
    transition: background-color 220ms cubic-bezier(0.2, 0, 0.1, 1);
    cursor: pointer;
  }
  .ui-switch__thumb {
    width: 18px;
    height: 18px;
    border-radius: 0px;
    background: var(--background);
    transform: translateX(0);
    transition: transform 220ms cubic-bezier(0.2, 0, 0.1, 1);
  }
  .ui-switch__input:checked + .ui-switch__track {
    background: var(--primary);
    border-color: var(--primary);
  }
  .ui-switch__input:checked + .ui-switch__track .ui-switch__thumb {
    background: var(--primary-foreground);
    transform: translateX(18px);
  }
  .ui-switch__input:focus-visible + .ui-switch__track {
    outline: 2px solid var(--ring);
    outline-offset: 2px;
  }
  .ui-switch__input:disabled + .ui-switch__track {
    opacity: 0.38;
    cursor: not-allowed;
  }
  .ui-switch__label {
    cursor: pointer;
  }
</style>
