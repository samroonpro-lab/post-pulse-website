---
/* MODIFIED: 2026-09-18 Post Pulse Design System Implementation */
import { cn } from "../../../../lib/cn";

export interface Props {
  id: string;
  name: string;
  label?: string;
  rows?: number;
  helperText?: string;
  errorText?: string;
  required?: boolean;
  class?: string;
  placeholder?: string;
  value?: string;
}

const {
  id,
  name,
  label,
  rows = 5,
  helperText,
  errorText,
  required = false,
  class: className,
  placeholder,
  value,
} = Astro.props as Props;
---

<label class="ui-field">
  {
    label && (
      <span class="ui-field__label">
        {label}
        {required && <span aria-hidden="true"> *</span>}
      </span>
    )
  }
  <textarea
    id={id}
    name={name}
    rows={rows}
    placeholder={placeholder}
    required={required}
    class={cn("ui-textarea", className, errorText && "ui-textarea--error")}
    >{value}</textarea
  >
  {
    helperText && !errorText && (
      <small class="ui-field__help">{helperText}</small>
    )
  }
  {errorText && <small class="ui-field__error">{errorText}</small>}
</label>

<style>
  .ui-field {
    display: grid;
    gap: 0.45rem;
  }
  .ui-field__label {
    font-weight: 600;
    font-size: 0.875rem;
  }
  .ui-textarea {
    width: 100%;
    font-family: var(--font-sans);
    font-size: var(--text-body);
    color: var(--foreground);
    background: transparent;
    border: none;
    border-bottom: 1px solid var(--line-hairline);
    border-radius: 0px;
    padding: 12px 0;
    resize: vertical;
    transition: border-color 220ms cubic-bezier(0.2, 0, 0.1, 1);
    min-height: 120px;
  }
  .ui-textarea::placeholder {
    color: var(--muted-foreground);
    opacity: 0.6;
  }
  .ui-textarea:hover {
    border-bottom-color: var(--line-light);
  }
  .ui-textarea:focus {
    outline: none;
    border-bottom: 2px solid var(--line-strong);
    padding: 12px 0;
  }
  .ui-textarea:disabled {
    opacity: 0.38;
    cursor: not-allowed;
  }
  .ui-textarea--error {
    border-bottom: 2px solid var(--destructive);
  }
  .ui-textarea--error:focus {
    border-bottom-color: var(--destructive);
  }
  .ui-field__help,
  .ui-field__error {
    font-size: 0.875rem;
  }
  .ui-field__help {
    color: var(--muted-foreground);
  }
  .ui-field__error {
    color: var(--destructive);
  }
</style>
