/* MODIFIED: 2026-09-18 Post Pulse Design System Implementation */
---
import { cn } from "../../../../lib/cn";

export interface Props {
  id: string;
  name: string;
  label?: string;
  helperText?: string;
  errorText?: string;
  required?: boolean;
  class?: string;
  type?: "text" | "email" | "tel" | "url" | "password" | "search" | "number";
  placeholder?: string;
  value?: string;
}

const {
  id,
  name,
  label,
  helperText,
  errorText,
  required = false,
  class: className,
  type = "text",
  placeholder,
  value,
} = Astro.props as Props;
---

<label class="ui-field">
  {
    label && (
      <span class="ui-field__label">
        {label}
        {required && <span aria-hidden="true"> *</span>}
      </span>
    )
  }
  <input
    id={id}
    name={name}
    type={type}
    placeholder={placeholder}
    value={value}
    required={required}
    class={cn("ui-input", className, errorText && "ui-input--error")}
  />
  {
    helperText && !errorText && (
      <small class="ui-field__help">{helperText}</small>
    )
  }
  {errorText && <small class="ui-field__error">{errorText}</small>}
</label>

/* MODIFIED: 2026-09-18 Post Pulse Design System Implementation */
<style>
  .ui-field {
    display: grid;
    gap: 0.45rem;
  }
  .ui-field__label {
    font-weight: 600;
    font-size: 0.875rem;
  }
  .ui-input {
    width: 100%;
    font-family: var(--font-sans);
    font-size: var(--text-body);
    color: var(--foreground);
    background: transparent;
    border: none;
    border-bottom: 1px solid var(--line-hairline);
    border-radius: 0px;
    padding: 12px 0;
    transition: border-color 220ms cubic-bezier(0.2, 0, 0.1, 1);
  }
  .ui-input::placeholder {
    color: var(--muted-foreground);
    opacity: 0.6;
  }
  .ui-input:hover {
    border-bottom-color: var(--line-light);
  }
  .ui-input:focus {
    outline: none;
    border-bottom: 2px solid var(--line-strong);
    padding: 12px 0;
  }
  .ui-input:disabled {
    opacity: 0.38;
    cursor: not-allowed;
  }
  .ui-input--error {
    border-bottom: 2px solid var(--destructive);
  }
  .ui-input--error:focus {
    border-bottom-color: var(--destructive);
  }
  .ui-field__help,
  .ui-field__error {
    font-size: 0.875rem;
  }
  .ui-field__help {
    color: var(--muted-foreground);
  }
  .ui-field__error {
    color: var(--destructive);
  }
</style>
