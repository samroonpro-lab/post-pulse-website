---
/* MODIFIED: 2026-09-18 Post Pulse Design System Implementation */
import { cn } from "../../../../lib/cn";

type BadgeVariant = "default" | "outline" | "secondary" | "destructive";
type BadgeSize = "sm" | "md";

const variantClasses: Record<BadgeVariant, string> = {
  default:
    "bg-muted text-foreground border border-border",
  outline:
    "border border-border text-foreground",
  secondary:
    "bg-accent/10 text-primary",
  destructive:
    "bg-destructive text-destructive-foreground",
};

const sizeClasses: Record<BadgeSize, string> = {
  sm: "px-2 py-0.5 text-xs",
  md: "px-3 py-1 text-sm",
};

export interface Props {
  variant?: BadgeVariant;
  size?: BadgeSize;
  class?: string;
}

const { variant, size, class: className } = Astro.props as Props;
---

<span
  class={cn(
    "inline-flex items-center font-medium border-radius-0",
    variant ? variantClasses[variant] : variantClasses.default,
    size ? sizeClasses[size] : sizeClasses.md,
    className,
  )}
  style="border-radius: 0px;"
>
  <slot />
</span>
