---
/* MODIFIED: 2026-09-18 Post Pulse Design System Implementation */
export interface Props {
  class?: string;
}

const { class: className } = Astro.props as Props;
---

<div class={["ui-table", className].filter(Boolean).join(" ")}>
  <slot />
</div>

<style>
  .ui-table {
    overflow-x: auto;
    border: 1px solid var(--border);
    border-radius: 0px;
  }
  .ui-table :global(table) {
    width: 100%;
    border-collapse: collapse;
  }
  .ui-table :global(th),
  .ui-table :global(td) {
    padding: var(--spacing-4);
    border-bottom: 1px solid var(--border);
    text-align: left;
    color: var(--foreground);
  }
  .ui-table :global(thead) {
    background: var(--muted);
  }
  .ui-table :global(th) {
    font-weight: 600;
  }
</style>
