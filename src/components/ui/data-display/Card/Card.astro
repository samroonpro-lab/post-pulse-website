/* MODIFIED: 2026-09-18 Post Pulse Design System Implementation */
---
import { cn } from "../../../../lib/cn";

export interface Props {
  class?: string;
  hover?: boolean;
}

const { class: className, hover = false } = Astro.props as Props;
---

<article class={cn("ui-card", hover && "ui-card--hover", className)}>
  <slot name="header" />
  <div class="ui-card__body">
    <slot />
  </div>
  <slot name="footer" />
</article>

<style>
  .ui-card {
    /* Post Pulse: minimal or no styling (image + text philosophy) */
    border: 1px solid var(--border);
    border-radius: 0px;
    background: transparent;
    overflow: visible;
  }
  .ui-card--hover {
    transition:
      transform 220ms cubic-bezier(0.2, 0, 0.1, 1),
      color 220ms cubic-bezier(0.2, 0, 0.1, 1);
  }
  .ui-card--hover:hover {
    /* Hover effect: image scales, title turns red */
    transform: none;
    box-shadow: none;
  }
  .ui-card__body {
    padding: var(--spacing-5);
  }
</style>
